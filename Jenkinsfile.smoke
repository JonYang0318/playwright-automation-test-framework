pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'demo-bank-e2e:smoke'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Image') {
            steps {
                bat 'docker build -t %IMAGE_NAME% .'
            }
        }

        stage('Run Smoke Tests') {
            steps {
                bat '''
                    docker run --rm ^
                      -e PYTHONPATH=/app ^
                      -v "%WORKSPACE%:/app" ^
                      -w /app ^
                      %IMAGE_NAME%
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'artifacts/**', allowEmptyArchive: true, fingerprint: true
        }
    }
}
